{
  "name": "agent-render",
  "version": "0.0.1",
  "description": "Render React, TSX, JSX, HTML, text, or URLs into screenshots for fast agent iteration.",
  "keywords": [],
  "license": "MIT",
  "author": "David",
  "bin": {
    "agent-render": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "skills"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "npm run build && changeset publish",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^14.0.3",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@types/node": "^22.19.11",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.88.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.8.0",
    "ultracite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
